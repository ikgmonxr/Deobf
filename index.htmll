<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#090b10">
  <title>Qyrex Deobfuscator</title>
  <style>
    :root{--bg:#07090d;--panel:rgba(15,18,25,.82);--panel2:#10141d;--line:rgba(255,255,255,.08);--text:#f3f6fb;--muted:#94a0b3;--purple:#a050ff;--cyan:#50dcff;--good:#65e6a7;--bad:#ff6b89;--shadow:0 24px 80px rgba(0,0,0,.45)}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 20% 0%,rgba(160,80,255,.12),transparent 30%),radial-gradient(circle at 90% 10%,rgba(80,220,255,.09),transparent 26%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
    body{padding:22px}.wrap{max-width:1400px;margin:0 auto}.top{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px}.brand{display:flex;gap:13px;align-items:center}.logo{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--purple),var(--cyan));box-shadow:0 0 32px rgba(160,80,255,.25);display:grid;place-items:center;font-weight:900;color:#05070b}.title h1{font-size:20px;margin:0}.title p{font-size:12px;color:var(--muted);margin:2px 0 0}.pill{border:1px solid var(--line);padding:8px 11px;border-radius:999px;color:var(--muted);font-size:12px;background:rgba(255,255,255,.03)}
    .toolbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:15px}.btn,.select,.input{font:inherit}.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:10px 13px;border-radius:11px;cursor:pointer;transition:.2s transform,.2s border-color,.2s background}.btn:hover{transform:translateY(-1px);border-color:rgba(80,220,255,.32)}.btn.primary{background:linear-gradient(135deg,rgba(160,80,255,.22),rgba(80,220,255,.16));border-color:rgba(80,220,255,.3)}.btn.danger{color:#ffc2cc}.select,.input{background:#0e1219;color:var(--text);border:1px solid var(--line);padding:10px 12px;border-radius:11px;outline:none}.input{min-width:260px;flex:1}.main{display:grid;grid-template-columns:1fr 1fr;gap:15px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden;backdrop-filter:blur(18px)}.cardhead{padding:12px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.cardhead b{font-size:13px}.sub{color:var(--muted);font-size:11px}.editor{width:100%;min-height:580px;resize:vertical;background:#090c12;color:#dce6f4;border:0;outline:0;padding:16px;font:13px/1.58 "Cascadia Code",Consolas,monospace;tab-size:2}.footerline{display:flex;justify-content:space-between;gap:10px;padding:9px 12px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}.status{display:flex;align-items:center;gap:7px}.dot{width:7px;height:7px;border-radius:50%;background:var(--good);box-shadow:0 0 12px rgba(101,230,167,.65)}.dot.busy{background:#ffd35d;box-shadow:0 0 12px rgba(255,211,93,.5)}.dot.bad{background:var(--bad);box-shadow:0 0 12px rgba(255,107,137,.5)}.message{margin-top:15px;padding:12px 14px;border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:14px;font-size:12px;color:var(--muted);white-space:pre-wrap}.message.good{border-color:rgba(101,230,167,.25);color:#c6ffe1}.message.bad{border-color:rgba(255,107,137,.25);color:#ffc0cd}.stats{display:flex;gap:12px;flex-wrap:wrap;padding:0 14px 14px}.stat{padding:9px 10px;border:1px solid var(--line);border-radius:11px;min-width:95px;background:rgba(255,255,255,.02)}.stat strong{display:block;font-size:13px}.stat span{display:block;font-size:10px;color:var(--muted);margin-top:2px}.drop{position:relative}.drop input{position:absolute;inset:0;opacity:0;cursor:pointer}.tips{margin-top:15px;color:var(--muted);font-size:11px;line-height:1.6}.apiRow{display:flex;gap:8px;flex:1}.small{font-size:10px;color:var(--muted)}
    @media(max-width:980px){.main{grid-template-columns:1fr}.editor{min-height:400px}.top{align-items:flex-start;flex-direction:column}.pill{align-self:flex-start}.input{min-width:180px}}
  </style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand"><div class="logo">Q</div><div class="title"><h1>Qyrex Deobfuscator</h1><p>Multi-engine Lua / Luau analysis and recovery</p></div></div>
    <div class="pill" id="healthPill">Checking backend…</div>
  </header>

  <div class="toolbar">
    <select id="engine" class="select" title="Engine">
      <option value="auto">Auto Detect</option>
      <option value="fusion">Fusion Pipeline</option>
      <option value="prometheus">Prometheus</option>
      <option value="envlog">Environment Logger</option>
      <option value="legacy-lph">Legacy LPH Analyzer</option>
    </select>
    <button class="btn primary" id="runBtn">▶ Deobfuscate</button>
    <label class="btn drop">Import .lua/.luau<input id="fileInput" type="file" accept=".lua,.luau,.txt,text/plain"></label>
    <button class="btn" id="copyBtn">Copy Output</button>
    <button class="btn" id="downloadBtn">Download .lua</button>
    <button class="btn danger" id="clearBtn">Clear</button>
  </div>

  <div class="card" style="margin-bottom:15px">
    <div class="cardhead"><div><b>Backend</b><div class="sub">GitHub Pages can point here with a Render/Railway backend.</div></div><div class="apiRow"><input id="apiUrl" class="input" spellcheck="false" placeholder="https://your-backend.example.com"><button class="btn" id="saveApi">Save API</button></div></div>
  </div>

  <section class="main">
    <article class="card">
      <div class="cardhead"><div><b>Input</b><div class="sub">Paste Lua or Luau source.</div></div><div class="small" id="inputMeta">0 chars</div></div>
      <textarea id="input" class="editor" spellcheck="false" placeholder="Paste an obfuscated Lua/Luau script here…"></textarea>
      <div class="footerline"><div class="status"><span class="dot" id="stateDot"></span><span id="stateText">Ready</span></div><span id="engineUsed">Engine: —</span></div>
    </article>

    <article class="card">
      <div class="cardhead"><div><b>Output</b><div class="sub">Recovered / analyzed source returned by the selected engine.</div></div><div class="small" id="outputMeta">0 chars</div></div>
      <textarea id="output" class="editor" spellcheck="false" readonly placeholder="Your result will appear here…"></textarea>
      <div class="stats" id="stats"></div>
    </article>
  </section>

  <div id="message" class="message">Ready. Auto Detect is recommended for mixed input.</div>
  <div class="tips">Security: the service only accepts text source, enforces size/rate/concurrency limits, kills timed-out child process trees, and keeps temporary job files under the OS temp directory.</div>
</div>
<script>
(() => {
  const $ = (id) => document.getElementById(id);
  const input = $('input'), output = $('output'), engine = $('engine'), message = $('message');
  const apiSaved = localStorage.getItem('qyrex_api_url') || '';
  const defaultApi = location.hostname === 'localhost' || location.hostname === '127.0.0.1' ? `${location.protocol}//${location.host}` : '';
  $('apiUrl').value = apiSaved || defaultApi;
  let lastResult = '';

  const setState = (state, text) => {
    $('stateDot').className = `dot ${state === 'busy' ? 'busy' : state === 'bad' ? 'bad' : ''}`;
    $('stateText').textContent = text;
  };
  const apiBase = () => ($('apiUrl').value || defaultApi || '').replace(/\/$/, '');
  const msg = (text, kind='') => { message.className = `message ${kind}`; message.textContent = text; };
  const updateMeta = () => $('inputMeta').textContent = `${input.value.length.toLocaleString()} chars · ${input.value.split(/\r?\n/).length.toLocaleString()} lines`;
  const setStats = (s) => {
    $('stats').innerHTML = '';
    if (!s) return;
    const data = [['Output', `${s.outputChars.toLocaleString()} chars`],['Lines', s.outputLines.toLocaleString()],['Functions', s.functions.toLocaleString()],['Locals', s.locals.toLocaleString()],['Overlap', `${s.tokenOverlap}%`]];
    for (const [a,b] of data) { const d = document.createElement('div'); d.className='stat'; d.innerHTML=`<strong>${b}</strong><span>${a}</span>`; $('stats').appendChild(d); }
  };

  input.addEventListener('input', updateMeta);
  $('fileInput').addEventListener('change', async (e) => { const f = e.target.files?.[0]; if (!f) return; input.value = await f.text(); updateMeta(); msg(`Loaded ${f.name} (${f.size.toLocaleString()} bytes).`); });
  $('saveApi').onclick = () => { const v = $('apiUrl').value.trim().replace(/\/$/, ''); localStorage.setItem('qyrex_api_url', v); msg(v ? 'Backend URL saved.' : 'Using same-origin backend.','good'); checkHealth(); };
  $('copyBtn').onclick = async () => { if (!output.value) return msg('Nothing to copy.','bad'); await navigator.clipboard.writeText(output.value); msg('Output copied to clipboard.','good'); };
  $('downloadBtn').onclick = () => { if (!output.value) return msg('Nothing to download.','bad'); const blob=new Blob([output.value],{type:'text/plain;charset=utf-8'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='qyrex-deobfuscated.lua'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),1000); };
  $('clearBtn').onclick = () => { input.value=''; output.value=''; lastResult=''; $('stats').innerHTML=''; $('outputMeta').textContent='0 chars'; $('engineUsed').textContent='Engine: —'; updateMeta(); msg('Cleared.'); };

  $('runBtn').onclick = async () => {
    const source = input.value;
    if (!source.trim()) return msg('Paste or import a Lua/Luau script first.','bad');
    const base = apiBase();
    if (!base) return msg('Set your backend URL above, or deploy the bundled server and open it directly.','bad');
    setState('busy','Processing…'); $('runBtn').disabled=true; $('engineUsed').textContent='Engine: running'; msg('Deobfuscation in progress…');
    try {
      const r = await fetch(`${base}/api/deobfuscate`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({script:source,engine:engine.value})});
      const data = await r.json().catch(()=>({ok:false,error:'Invalid server response.'}));
      if (!r.ok || !data.ok) throw new Error(data.error || 'Deobfuscation failed.');
      output.value = data.output || ''; lastResult=output.value; $('outputMeta').textContent=`${output.value.length.toLocaleString()} chars`; $('engineUsed').textContent=`Engine: ${data.engine}`; setStats(data.stats); setState('','Ready'); msg(`Completed in ${data.ms} ms using ${data.engine}.`,'good');
    } catch (e) { setState('bad','Error'); msg(e.message || 'Request failed.','bad'); }
    finally { $('runBtn').disabled=false; }
  };

  async function checkHealth(){
    const base=apiBase(); if(!base){$('healthPill').textContent='Backend URL required';return;}
    try{const r=await fetch(`${base}/api/health`);const d=await r.json();$('healthPill').textContent=d.ok?`Backend online · ${d.activeJobs}/${d.maxConcurrent}`:'Backend error';}catch{$('healthPill').textContent='Backend offline';}
  }
  updateMeta(); checkHealth();
})();
</script>
</body>
</html>
